# The website's settings on the server. Copy to /etc/msbd/frontend.env (chmod 600). BACKEND_URL is set by compose.yaml.

# Cloudflare tells the real visitor address in this header; the firewall lets only Cloudflare reach the server.
CLIENT_IP_HEADER=cf-connecting-ip

# Google Search Console HTML-tag token (optional).
# GOOGLE_SITE_VERIFICATION=
