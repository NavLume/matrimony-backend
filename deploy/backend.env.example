# The API's settings on the server. Copy to /etc/msbd/backend.env (chmod 600) and fill in. Never commit the real file.

NODE_ENV=production
LOG_LEVEL=info

# DigitalOcean managed PostgreSQL. Use the VPC (private) host and port 25060. Remove "?sslmode=require" from the address
# DigitalOcean shows: TLS is set by DB_SSL and DB_CA_FILE below, and the API refuses flags in the URL.
# The runtime login is a limited role (member of matrimony_runtime), never doadmin.
DATABASE_URL=postgresql://matrimony_app:CHANGE_ME@private-msbd-db-CHANGE_ME.db.ondigitalocean.com:25060/matrimony
# Migrations only (docker compose run --rm tools).
MIGRATION_DATABASE_URL=postgresql://doadmin:CHANGE_ME@private-msbd-db-CHANGE_ME.db.ondigitalocean.com:25060/matrimony
DB_SSL=verify-full
DB_CA_FILE=/etc/msbd/db-ca.crt
# The 1 GB database allows 22 connections; keep room for migrations and the console.
DB_POOL_MAX=10

# Redis runs in the container next to the API and is not published, so a plain connection is allowed (only to it).
REDIS_URL=redis://redis:6379
ALLOW_PLAINTEXT_LOCAL_SERVICES=true

# The site's addresses and the agency they show (the agency's id from the database).
TENANT_HOSTS={"msbdmatrimony.com":"CHANGE_ME_AGENCY_UUID","www.msbdmatrimony.com":"CHANGE_ME_AGENCY_UUID"}

# New values for this server; never reuse the development ones.
#   AUTH_JWT_PRIVATE_KEY: npm run auth:keygen (one line, with \n)
#   SESSION_ENCRYPTION_KEY: openssl rand -hex 32
AUTH_JWT_PRIVATE_KEY=
SESSION_ENCRYPTION_KEY=

# Only the website container may say who the visitor is (compose network "app").
TRUST_PROXY=172.30.0.0/24

# Account emails (registration link, password reset). Production refuses the console driver.
MAIL_DRIVER=smtp
MAIL_FROM=Marriage Solution BD <no-reply@msbdmatrimony.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=

# Phone sign-in stays off until a real SMS gateway exists (production refuses the console driver).
# SMS_DRIVER=

# Files in Cloudflare R2 (S3-compatible). Production refuses a local disk.
STORAGE_DRIVER=s3
S3_BUCKET=msbd-files
S3_REGION=auto
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sign-in with Google (optional; both or neither). Use a new secret; the old one was exposed.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile on the buttons that send a code (both or neither; the site key is public).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Text messages: SMS_DRIVER=smsnetbd and the key from portal.sms.net.bd (API page).
# SMS_DRIVER=smsnetbd
# SMSNETBD_API_KEY=
# SMSNETBD_SENDER_ID=
